{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sample-shop.test/error.json",
  "title": "Error response (every 4xx/5xx)",
  "type": "object",
  "additionalProperties": false,
  "required": ["detail", "code", "correlation_id"],
  "properties": {
    "detail": {"type": "string", "minLength": 1},
    "code": {"type": "string", "pattern": "^[a-z_]+$"},
    "correlation_id": {"type": ["string", "null"]},
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "message"],
        "properties": {"field": {"type": "string"}, "message": {"type": "string", "minLength": 1}}
      }
    }
  }
}
