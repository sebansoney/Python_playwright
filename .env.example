# Copy this file to .env and adjust. .env is git-ignored - never commit it.
# Anything set here overrides config/*.yaml. Nested keys use "__".

# Which config/environments/<name>.yaml to load (or use: pytest --env <name>)
TEST_ENV=local

# --- Test accounts for the LOCAL sample application -------------------------
# These are demo-only credentials for the app that runs on your own machine.
# The sample app seeds its users from these same variables, so they always match.
FW_CREDENTIALS__ADMIN_USERNAME=admin@example.test
FW_CREDENTIALS__ADMIN_PASSWORD=change-me-Admin#1
FW_CREDENTIALS__USER_USERNAME=user@example.test
FW_CREDENTIALS__USER_PASSWORD=change-me-User#1

# --- Sample application (system under test) ---------------------------------
# APP_ENV=test enables POST /api/v1/test-support/reset (never enable in a real deployment)
APP_ENV=test
# APP_PORT=8000
# APP_DATABASE_URL=sqlite:///sample_application/database/app.db
# APP_JWT_SECRET=   (random per start if empty)
# APP_TOKEN_TTL_MINUTES=60

# --- Optional examples of overriding config ---------------------------------
# FW_BROWSER__HEADLESS=false
# FW_BROWSER__SLOW_MO_MS=250
# FW_API__TIMEOUT_S=5

# --- AI (optional) ----------------------------------------------------------
# Leave empty to run without AI. Get a key from https://console.anthropic.com
# FW_AI__ENABLED=true
# FW_AI__MODEL=claude-sonnet-5-5   # default claude-opus-5-5
ANTHROPIC_API_KEY=
# FW_AI_LIVE=1   # only to run tests/ai_live (real, billed API calls)
