{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sample-app",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "sample_application", "--env", "test", "--reset-db", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "sample-report",
      "runtimeExecutable": ".venv/Scripts/python.exe",
